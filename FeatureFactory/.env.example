FEATURE_FACTORY_DATABASE_URL=postgresql+psycopg://feature_factory:feature_factory@127.0.0.1:55432/feature_factory
FEATURE_FACTORY_GITHUB_TOKEN=
FEATURE_FACTORY_STAGE1_MAX_CONCURRENT_JOBS=2
FEATURE_FACTORY_STAGE1_DEFAULT_MAX_CONCURRENT_PARTITIONS_PER_JOB=8
FEATURE_FACTORY_GITHUB_PARTITION_RESULT_LIMIT=900
FEATURE_FACTORY_GITHUB_INCOMPLETE_RESULTS_RETRIES=3
FEATURE_FACTORY_STAGE2_OPENHANDS_SDK_ROOT=./software-agent-sdk
FEATURE_FACTORY_STAGE2_OPENHANDS_PRESET=default
FEATURE_FACTORY_STAGE2_OPENHANDS_MAX_ITERATIONS=150
FEATURE_FACTORY_STAGE2_ENABLE_CHECKPOINTS=1
FEATURE_FACTORY_STAGE3_ENABLE_CHECKPOINTS=1
FEATURE_FACTORY_STAGE3_RUNTIME_IMAGE_AUTO_PRUNE=1
FEATURE_FACTORY_STAGE3_RUNTIME_IMAGE_RETENTION_DAYS=7
FEATURE_FACTORY_STAGE3_RUNTIME_IMAGE_PRUNE_INTERVAL_DAYS=1
FEATURE_FACTORY_OPENHANDS_ENABLE_ENCRYPTED_REASONING=1

# Comma-separated Stage4 issue styles defined in
# src/feature_factory/stage4/assets/issue_styles/config.json.
# Available built-in styles: swe, fb, hint.
FEATURE_FACTORY_STAGE4_ISSUE_STYLES=swe,fb

# Keep TLS certificate verification enabled for LLM endpoints by default.
# Set to false only for a trusted endpoint with a self-signed certificate.
# This setting is scoped to the OpenHands LLM bridge and is not forwarded to
# Docker sandboxes or package/repository download commands.
FEATURE_FACTORY_LLM_SSL_VERIFY=true

# Huawei LLM OpenHands adapter.
# For the internal Huawei OpenAI-compatible endpoints, these three are enough.
# Known deployment model values include glm-5-w4a8 and kimi-k2.6-w4a8. When the UI
# model matches this deployment model, the isolated Huawei adapter auto-adds
# the LiteLLM openai/ provider prefix, per-run X-Session-Id, and session_release cleanup.
# FEATURE_FACTORY_HUAWEI_LLM_MODEL=glm-5-w4a8
# FEATURE_FACTORY_HUAWEI_LLM_MODEL=kimi-k2.6-w4a8
# FEATURE_FACTORY_HUAWEI_LLM_BASE_URL=http://10.43.2.226:7486/v1
# FEATURE_FACTORY_HUAWEI_LLM_API_KEY=dummy
# Defaults to 1. Set to 0 to stop OpenHands from treating Huawei models as
# reasoning-capable and from forwarding reasoning/reasoning_content history.
# FEATURE_FACTORY_HUAWEI_LLM_ENABLE_REASONING=1

# China mirror overrides.
# Uncomment FEATURE_FACTORY_STAGE2_USE_CHINA_MIRRORS to force China mirror mode.
# If the host timezone is already China, FeatureFactory auto-enables this mode.
# FEATURE_FACTORY_STAGE2_USE_CHINA_MIRRORS=1

# Docker registry proxies used only for public image pulls during local builds.
# Local FeatureFactory images such as feature-factory/... are never rewritten.
# FEATURE_FACTORY_DOCKER_USE_CHINA_MIRRORS=1
# FEATURE_FACTORY_DOCKER_IO_MIRROR=docker.1ms.run
# FEATURE_FACTORY_GHCR_IO_MIRROR=ghcr.m.daocloud.io

# Package/download mirrors used by Stage2 base-image and agent-server builds.
# FEATURE_FACTORY_STAGE2_PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
# FEATURE_FACTORY_STAGE2_TORCH_CPU_FIND_LINKS=https://mirrors.aliyun.com/pytorch-wheels/cpu
# FEATURE_FACTORY_STAGE2_UV_INDEX_URL=https://mirrors.tuna.tsinghua.edu.cn/pypi/web/simple/
# FEATURE_FACTORY_STAGE2_UV_PYTHON_INSTALL_MIRROR=https://ghfast.top/https://github.com/astral-sh/python-build-standalone/releases/download
# FEATURE_FACTORY_STAGE2_UV_PYTHON_INSTALL_MIRROR_FALLBACKS=
# FEATURE_FACTORY_STAGE2_UV_HTTP_TIMEOUT=300
# FEATURE_FACTORY_STAGE2_UV_HTTP_RETRIES=8
# Accepts one URL, a comma/newline-separated list, or a JSON array. Retryable
# Git failures move the active proxy to the shared queue's tail.
# FEATURE_FACTORY_STAGE2_GITHUB_PROXY_PREFIX='["https://gh-proxy.com/","https://ghfast.top/","https://ghproxy.vip/","https://githubproxy.cc/"]'
# FEATURE_FACTORY_STAGE2_GIT_REMOTE_TIMEOUT_SECONDS=20
# FEATURE_FACTORY_STAGE2_NPM_REGISTRY=https://registry.npmmirror.com
# FEATURE_FACTORY_STAGE2_NODE_DIST_MIRROR=https://cdn.npmmirror.com/binaries/node
# FEATURE_FACTORY_STAGE2_MINICONDA_DIST_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/anaconda/miniconda
# FEATURE_FACTORY_STAGE2_DEBIAN_APT_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/debian
# FEATURE_FACTORY_STAGE2_DEBIAN_SECURITY_APT_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/debian-security
# FEATURE_FACTORY_STAGE2_DEBIAN_APT_MIRROR_BOOTSTRAP=http://mirrors.tuna.tsinghua.edu.cn/debian
# FEATURE_FACTORY_STAGE2_DEBIAN_SECURITY_APT_MIRROR_BOOTSTRAP=http://mirrors.tuna.tsinghua.edu.cn/debian-security
# FEATURE_FACTORY_STAGE2_UBUNTU_APT_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/ubuntu
# FEATURE_FACTORY_STAGE2_UBUNTU_PORTS_APT_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/ubuntu-ports
# FEATURE_FACTORY_STAGE2_UBUNTU_APT_MIRROR_BOOTSTRAP=http://mirrors.tuna.tsinghua.edu.cn/ubuntu
# FEATURE_FACTORY_STAGE2_UBUNTU_PORTS_APT_MIRROR_BOOTSTRAP=http://mirrors.tuna.tsinghua.edu.cn/ubuntu-ports
# FEATURE_FACTORY_STAGE2_MAVEN_MIRROR=https://maven.aliyun.com/repository/public
# FEATURE_FACTORY_STAGE2_RUBYGEMS_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/rubygems/