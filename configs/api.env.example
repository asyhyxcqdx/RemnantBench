# 在仓库根目录复制为 .env，全部模型密钥集中放在这一个私有文件。
# 相同渠道可填写同一个密钥；只需填写本机计划运行的模型。
ASTRA_API_KEY=
SOL_API_KEY=
CLAUDE_API_KEY=
GEMINI_API_KEY=
KIMI_API_KEY=
GLM_API_KEY=
DEEPSEEK_API_KEY=

# 原 run_harbor 用它确定允许访问的主机；实际请求地址保留在各模型 YAML 中。
LLM_BASE_URL=https://api.openlux.ai/v1

# 不在此定义 MSWEA_API_KEY：运行命令会为本次进程选择对应模型的密钥。
